# Plantilla de configuración para entornos explícitamente configurados.
# En desarrollo local NO hay que copiar este archivo: manage.py genera un .env
# automáticamente (DJANGO_DEBUG=1 + secret aleatorio) si no hay variables
# DJANGO_SECRET_KEY / DJANGO_DEBUG en el entorno y aún no existe .env.
# Si ya hay configuración, el bootstrap no sobrescribe nada.
# NUNCA subir el .env con el secret real: sólo este archivo está versionado.
# Las variables exportadas en el entorno del proceso tienen prioridad sobre
# los valores de este archivo.

# --- Seguridad -----------------------------------------------------------
# 0 = producción (default seguro). Usar 1 SOLO para desarrollo local.
DJANGO_DEBUG=0

# Secret real. En producción es obligatorio: generalo con
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Con DJANGO_DEBUG=0 y secret vacío, el arranque falla.
DJANGO_SECRET_KEY=

# Hosts permitidos separados por comas. Requerido cuando DJANGO_DEBUG=0.
# En desarrollo se añaden automáticamente localhost, 127.0.0.1 y [::1].
DJANGO_ALLOWED_HOSTS=ejemplo.com,www.ejemplo.com

# --- Aplicación ----------------------------------------------------------
# Temporada mostrada por el hub.
F1_SEASON_YEAR=2026

# Días de validez de la caché de telemetría.
TELEMETRY_CACHE_TTL_DAYS=7

# Máximo de sesiones ofrecidas en el selector de telemetría.
TELEMETRY_SESSION_LIMIT=50
